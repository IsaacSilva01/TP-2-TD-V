{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build GAP project",
      "type": "shell",
      "command": "make",
      "args": [
        "-C",
        "tp2/src"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compila todo el proyecto con el Makefile de tp2/src para resolver todas las dependencias."
    }
  ]
}