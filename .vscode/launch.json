{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run GAP simulator",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/tp2/src/gap_simulator",
      "args": [
        "${workspaceFolder}/tp2/src/instances/gap/gap_a/a05100",
        "${workspaceFolder}/tp2/src/salida.txt"
      ],
      "cwd": "${workspaceFolder}/tp2/src",
      "stopAtEntry": false,
      "externalConsole": true,
      "preLaunchTask": "Build GAP project",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Habilitar pretty-printing para gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
